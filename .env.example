# Copy this file to ".env" and fill it in. Never commit ".env".

PORT=8787

# Admin panel login (/admin). Choose a strong password!
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
# Any long random text. Keeps admin sessions valid after restarts.
SESSION_SECRET=change-this-to-a-long-random-text

# Telegram notifications (new booking -> message to your Telegram)
# 1. Telegram -> @BotFather -> /newbot -> copy the token here
# 2. From the Telegram account +998 90 710 64 64 open your bot and press START
# 3. Run: npm run telegram:setup   (fills TELEGRAM_CHAT_ID automatically)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: public website address, added as a link in Telegram messages
SITE_URL=
